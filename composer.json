{
    "name": "themsaid/wink",
    "description": "Wink Publishing Framework.",
    "keywords": ["framework", "laravel", "blog"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Said",
            "email": "mohamed@laravel.com"
        }
    ],
    "require": {
        "php": "^7.3||^7.4||^8.0",
        "ext-curl": "*",
        "laravel/framework": "^7.0||^8.0||^9.0|^10.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0"
    },
    "suggest": {
        "ext-imagick": "Faster featured image processing (falls back to GD)."
    },
    "autoload": {
        "psr-4": {
            "Wink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wink\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Wink\\WinkServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
